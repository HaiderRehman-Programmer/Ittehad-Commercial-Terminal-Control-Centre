# ====================================================
# Environment Configuration Template
# Copy this to .env and fill in your actual values.
# NEVER commit your real .env file to version control!
# ====================================================

# --- Server ---
NODE_ENV=development          # development | production
PORT=5000
FRONTEND_URL=http://localhost:5173

# --- Database ---
# PostgreSQL (Recommended):
DATABASE_URL="postgresql://postgres:password@localhost:5432/real_estate_erp?schema=public"
# SQLite (Legacy):
# DATABASE_URL="file:./prisma/dev.db"

# --- Authentication (REQUIRED) ---
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# The server will refuse to start if JWT_SECRET is not set.
JWT_SECRET=REPLACE_ME_WITH_A_64_CHAR_RANDOM_HEX_STRING
JWT_EXPIRY=12h

# --- Security ---
BCRYPT_ROUNDS=10
API_RATE_LIMIT=100            # Max login attempts per window
API_RATE_WINDOW_MS=900000     # Rate limit window (15 min)

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Logging ---
LOG_LEVEL=debug               # debug | info | warn | error
